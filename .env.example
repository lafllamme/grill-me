# Nuxt runtime config (server-only)
NUXT_CF_ACCOUNT_ID=
NUXT_CF_API_TOKEN=
NUXT_CF_AI_MODEL=@cf/qwen/qwen3-30b-a3b-fp8
NUXT_GITHUB_TOKEN=
NUXT_CF_AI_TIMEOUT_MS=30000
NUXT_CF_AI_MAX_TOKENS=240
NUXT_GITHUB_TIMEOUT_MS=12000
NUXT_ROAST_DEBUG=true
NUXT_PUBLIC_ROAST_DEBUG=true
# Dashboard trace: off | summary | full (full is local/server-only).
NUXT_DASHBOARD_TRACE_LEVEL=summary
NUXT_PUBLIC_DASHBOARD_TRACE_LEVEL=summary
# One local Markdown trace file per server analysis; leave empty to disable.
NUXT_DASHBOARD_TRACE_FILE_DIR=logs/dashboard

# Auth + receipt security.
# Session password must be at least 32 chars.
NUXT_SESSION_PASSWORD=
NUXT_OAUTH_GITHUB_CLIENT_ID=
NUXT_OAUTH_GITHUB_CLIENT_SECRET=
NUXT_ROAST_RECEIPT_SECRET=

# Required for Neon/Postgres leaderboard persistence.
# Fill this before running production-like end-to-end tests.
NUXT_DATABASE_URL=
